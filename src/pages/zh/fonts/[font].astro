---
import Layout from '../../../layouts/Layout.astro';
import { POPULAR_FONTS, type FontItem } from '../../../data/fontsData';
import 'remixicon/fonts/remixicon.css';
import '../../../styles/index.css';

export function getStaticPaths() {
  return POPULAR_FONTS.map(font => ({
    params: { font: font.slug },
    props: { font },
  }));
}

interface Props {
  font: FontItem;
}

const { font } = Astro.props;

const pageTitle = `${font.name} 字体在线转 SVG 路径 / CAD DXF 生成器 | FontSVG`;
const pageDescription = `免费在线将 ${font.name} 字体转换为纯净矢量 SVG 路径（<path d="...">）与 CAD DXF 图纸。支持连笔草书布尔焊接与毫米尺寸设置，无需安装字体文件。`;
const relatedFonts = POPULAR_FONTS.filter(f => f.slug !== font.slug && f.category === font.category).slice(0, 8);
const toolUrl = `/zh/?font=${encodeURIComponent(font.name)}&union=${font.recommendedUnion}&text=${encodeURIComponent(font.defaultText)}`;
---

<Layout
  isApp={false}
  lang="zh"
  title={pageTitle}
  description={pageDescription}
>
  <div class="about-page">
    <header class="about-hero">
      <div class="seo-container">
        <span class="badge"><i class="ri-font-size"></i> {font.category.toUpperCase()} 字体专题</span>
        <h1 class="hero-title">将 {font.name} 转换为 SVG 矢量路径与 CAD DXF 轮廓</h1>
        <p class="hero-subtitle">
          {font.descriptionZh}
        </p>
        <div class="hero-actions">
          <a href={toolUrl} class="btn btn-primary">
            <i class="ri-magic-line"></i>
            <span>在主工具中制作 {font.name} 矢量</span>
          </a>
          <a href="/zh/fonts/" class="btn btn-outline">
            <i class="ri-arrow-left-line"></i>
            <span>返回字体库目录</span>
          </a>
        </div>
      </div>
    </header>

    <!-- 专属字体排版与矢量化指南 -->
    <section class="seo-section" id="overview">
      <div class="seo-container">
        <div class="features-grid">
          <article class="feature-card">
            <div class="feature-icon"><i class="ri-magic-line"></i></div>
            <h3>推荐应用场景</h3>
            <p>{font.bestForZh}</p>
          </article>

          <article class="feature-card">
            <div class="feature-icon"><i class="ri-shape-line"></i></div>
            <h3>笔画焊接建议</h3>
            <p>
              {font.recommendedUnion ? (
                <>
                  <strong>建议开启 Union（联集）：</strong> 该字体属于连笔/手写字体，相邻字母笔画自然交叠。开启布尔合并可消除交叉内线，防止激光雕刻和刻字机切烂材料。
                </>
              ) : (
                <>
                  <strong>独立外轮廓：</strong> 该字体各字母间距独立清晰，通常无需开启 Union，直接导出即可获得干净轮廓。
                </>
              )}
            </p>
          </article>

          <article class="feature-card">
            <div class="feature-icon"><i class="ri-ruler-2-line"></i></div>
            <h3>激光与 CNC 雕刻适配</h3>
            <p>
              可直接将 {font.name} 文本导出为包含毫米或英寸实际物理尺寸的 Autodesk DXF 图纸，直接导入 LightBurn 或数控机床加工。
            </p>
          </article>

          <article class="feature-card">
            <div class="feature-icon"><i class="ri-shield-check-line"></i></div>
            <h3>纯浏览器本地计算</h3>
            <p>
              通过 OpenType.js 本地计算提取字形曲线，零数据上传。一键复制纯净 <code>&lt;path d="..."&gt;</code> 代码至前端剪贴板。
            </p>
          </article>
        </div>

        <!-- 字体样张展示 -->
        <div class="font-preview-specimen">
          {font.name} • ABCDEFGHIJKLMNOPQRSTUVWXYZ • 0123456789
        </div>
      </div>
    </section>

    <!-- 针对该字体的操作指南 -->
    <section class="seo-section bg-alt">
      <div class="seo-container">
        <div class="section-header">
          <span class="badge"><i class="ri-book-open-line"></i> 快速上手</span>
          <h2>如何转换 {font.name} 字体</h2>
          <p class="subtitle">简单四步，快速获取专属矢量代码或 CAD 切割图纸。</p>
        </div>

        <div class="steps-grid">
          <div class="step-card">
            <div class="step-number">1</div>
            <h3>启动并进入工作台</h3>
            <p>点击按钮打开转换器，已为您默认预设载入 <strong>{font.name}</strong> 字体与推荐参数。</p>
          </div>

          <div class="step-card">
            <div class="step-number">2</div>
            <h3>微调字号与间距</h3>
            <p>按需滑动调节字号、字距微调（Kerning）以及多行行高，适配您的设计版面或加工尺寸。</p>
          </div>

          <div class="step-card">
            <div class="step-number">3</div>
            <h3>确认焊接开关 (Union)</h3>
            <p>
              {font.recommendedUnion ? '建议保持勾选“合并重叠路径 (Union)”，自动融接连笔笔触。' : '保持不勾选 Union，保持各个字母独立边界。'}
            </p>
          </div>

          <div class="step-card">
            <div class="step-number">4</div>
            <h3>一键复制或下载文件</h3>
            <p>点击“复制 SVG 路径”粘贴进代码，或点击“SVG / DXF”下载图纸直接开工切割。</p>
          </div>
        </div>

        <div style="text-align: center; margin-top: 3rem;">
          <a href={toolUrl} class="btn btn-primary">
            <i class="ri-magic-line"></i>
            <span>立即制作 {font.name} 矢量</span>
          </a>
        </div>
      </div>
    </section>

    <!-- 相关字体推荐 -->
    {relatedFonts.length > 0 && (
      <section class="seo-section">
        <div class="seo-container">
          <div class="section-header">
            <span class="badge"><i class="ri-node-tree"></i> 相似字体推荐</span>
            <h2>探索更多 {font.category} 风格字体</h2>
            <p class="subtitle">查看其它同样适用该场景的热门字体。</p>
          </div>

          <div class="font-pills-container">
            {relatedFonts.map(rf => (
              <a href={`/zh/fonts/${rf.slug}/`} class="font-pill">
                <span>{rf.name}</span>
                <span class="font-pill-cat">{rf.category}</span>
              </a>
            ))}
            <a href="/zh/fonts/" class="font-pill" style="border-color: #3b82f6; color: #2563eb;">
              <span>查看全部字体库目录 &rarr;</span>
            </a>
          </div>
        </div>
      </section>
    )}
  </div>
</Layout>
