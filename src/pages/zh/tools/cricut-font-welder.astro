---
import Layout from '../../../layouts/Layout.astro';
import { USE_CASES } from '../../../data/useCasesData';
import { POPULAR_FONTS } from '../../../data/fontsData';
import 'remixicon/fonts/remixicon.css';
import '../../../styles/index.css';

const data = USE_CASES['cricut-font-welder'];
const scriptFonts = POPULAR_FONTS.filter(f => f.category === 'handwriting').slice(0, 12);
const toolUrl = `/zh/?font=${encodeURIComponent(data.initialFont)}&union=true&text=${encodeURIComponent(data.initialText)}`;
---

<Layout
  isApp={false}
  lang="zh"
  title={data.seoTitleZh}
  description={data.seoDescriptionZh}
>
  <div class="about-page">
    <header class="about-hero">
      <div class="seo-container">
        <span class="badge"><i class="ri-scissors-cut-line"></i> {data.badgeZh}</span>
        <h1 class="hero-title">{data.titleZh}</h1>
        <p class="hero-subtitle">{data.subtitleZh}</p>
        <div class="hero-actions">
          <a href={toolUrl} class="btn btn-primary">
            <i class="ri-magic-line"></i>
            <span>启动 Cricut 连笔焊接工具</span>
          </a>
          <a href="#guide" class="btn btn-outline">
            <i class="ri-book-open-line"></i>
            <span>查看操作指南</span>
          </a>
        </div>
      </div>
    </header>

    <!-- 核心痛点与价值总览 -->
    <section class="seo-section" id="overview">
      <div class="seo-container">
        <!-- 为什么需要焊接的警示框 -->
        <div style="background: #eff6ff; border: 1px solid #bfdbfe; border-radius: 12px; padding: 1.5rem 1.75rem; margin-bottom: 3.5rem;">
          <h3 style="font-size: 1.125rem; font-weight: 700; color: #1e40af; margin: 0 0 0.5rem; display: flex; align-items: center; gap: 0.5rem;">
            <i class="ri-information-fill"></i> {data.whyTitleZh}
          </h3>
          <p style="font-size: 0.9375rem; color: #1e3a8a; line-height: 1.6; margin: 0;">
            {data.whyContentZh}
          </p>
        </div>

        <div class="features-grid">
          {data.features.map(f => (
            <article class="feature-card">
              <div class="feature-icon"><i class={f.icon}></i></div>
              <h3>{f.titleZh}</h3>
              <p>{f.descZh}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- 图文步骤指南 -->
    <section class="seo-section bg-alt" id="guide">
      <div class="seo-container">
        <div class="section-header">
          <span class="badge"><i class="ri-book-open-line"></i> 操作步骤</span>
          <h2>如何焊接草书字体并导入 Cricut 切割</h2>
          <p class="subtitle">无需安装 Illustrator，简单四步完成高品质压纹字切割。</p>
        </div>

        <div class="steps-grid">
          {data.steps.map((s, idx) => (
            <div class="step-card">
              <div class="step-number">{idx + 1}</div>
              <h3>{s.titleZh}</h3>
              <p>{s.descZh}</p>
            </div>
          ))}
        </div>

        <div style="text-align: center; margin-top: 3rem;">
          <a href={toolUrl} class="btn btn-primary">
            <i class="ri-magic-line"></i>
            <span>立即在线制作焊接 SVG</span>
          </a>
        </div>
      </div>
    </section>

    <!-- 推荐常用连笔草书字体 -->
    <section class="seo-section" id="fonts">
      <div class="seo-container">
        <div class="section-header">
          <span class="badge"><i class="ri-heart-line"></i> 常用连笔字</span>
          <h2>适合 Cricut 刻字机切割的经典草书</h2>
          <p class="subtitle">点击任意字体进入专属调优页面。</p>
        </div>

        <div class="font-pills-container">
          {scriptFonts.map(sf => (
            <a href={`/zh/fonts/${sf.slug}/`} class="font-pill">
              <span>{sf.name}</span>
              <span class="font-pill-cat">支持一键焊接</span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- 常见问题解答 -->
    <section class="seo-section bg-alt" id="faq">
      <div class="seo-container">
        <div class="section-header">
          <span class="badge"><i class="ri-question-line"></i> Cricut 疑难答疑</span>
          <h2>常见问题解答</h2>
          <p class="subtitle">关于连笔焊接与切割文件导出的详细说明。</p>
        </div>

        <div class="faq-list">
          {data.faq.map(item => (
            <details class="faq-item" open>
              <summary class="faq-question">{item.qZh}</summary>
              <div class="faq-answer">
                <p>{item.aZh}</p>
              </div>
            </details>
          ))}
        </div>
      </div>
    </section>
  </div>
</Layout>
