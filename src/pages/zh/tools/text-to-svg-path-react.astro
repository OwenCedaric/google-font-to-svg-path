---
import Layout from '../../../layouts/Layout.astro';
import { USE_CASES } from '../../../data/useCasesData';
import { POPULAR_FONTS } from '../../../data/fontsData';
import 'remixicon/fonts/remixicon.css';
import '../../../styles/index.css';

const data = USE_CASES['text-to-svg-path-react'];
const modernFonts = POPULAR_FONTS.filter(f => f.category === 'sans-serif' || f.category === 'serif' || f.category === 'cjk').slice(0, 12);
const toolUrl = `/zh/?font=${encodeURIComponent(data.initialFont)}&filled=true&text=${encodeURIComponent(data.initialText)}`;
---

<Layout
  isApp={false}
  lang="zh"
  title={data.seoTitleZh}
  description={data.seoDescriptionZh}
>
  <div class="about-page">
    <header class="about-hero">
      <div class="seo-container">
        <span class="badge"><i class="ri-reactjs-line"></i> {data.badgeZh}</span>
        <h1 class="hero-title">{data.titleZh}</h1>
        <p class="hero-subtitle">{data.subtitleZh}</p>
        <div class="hero-actions">
          <a href={toolUrl} class="btn btn-primary">
            <i class="ri-magic-line"></i>
            <span>启动 React 路径提取器</span>
          </a>
          <a href="#guide" class="btn btn-outline">
            <i class="ri-code-box-line"></i>
            <span>前端集成说明</span>
          </a>
        </div>
      </div>
    </header>

    <!-- 核心优势 -->
    <section class="seo-section" id="overview">
      <div class="seo-container">
        <!-- 为什么 SVG Path 远优于字体包 -->
        <div style="background: #eff6ff; border: 1px solid #bfdbfe; border-radius: 12px; padding: 1.5rem 1.75rem; margin-bottom: 3.5rem;">
          <h3 style="font-size: 1.125rem; font-weight: 700; color: #1e40af; margin: 0 0 0.5rem; display: flex; align-items: center; gap: 0.5rem;">
            <i class="ri-flashlight-fill"></i> {data.whyTitleZh}
          </h3>
          <p style="font-size: 0.9375rem; color: #1e3a8a; line-height: 1.6; margin: 0;">
            {data.whyContentZh}
          </p>
        </div>

        <div class="features-grid">
          {data.features.map(f => (
            <article class="feature-card">
              <div class="feature-icon"><i class={f.icon}></i></div>
              <h3>{f.titleZh}</h3>
              <p>{f.descZh}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- 步骤指南 -->
    <section class="seo-section bg-alt" id="guide">
      <div class="seo-container">
        <div class="section-header">
          <span class="badge"><i class="ri-code-box-line"></i> 开发者操作指南</span>
          <h2>如何将提取的路径内联进 React 与 Three.js</h2>
          <p class="subtitle">零运行时下载，首屏毫秒级呈现纯净矢量图形。</p>
        </div>

        <div class="steps-grid">
          {data.steps.map((s, idx) => (
            <div class="step-card">
              <div class="step-number">{idx + 1}</div>
              <h3>{s.titleZh}</h3>
              <p>{s.descZh}</p>
            </div>
          ))}
        </div>

        <div style="text-align: center; margin-top: 3rem;">
          <a href={toolUrl} class="btn btn-primary">
            <i class="ri-magic-line"></i>
            <span>打开主工具提取 &lt;path d&gt;</span>
          </a>
        </div>
      </div>
    </section>

    <!-- 推荐现代无衬线与品牌字体 -->
    <section class="seo-section" id="fonts">
      <div class="seo-container">
        <div class="section-header">
          <span class="badge"><i class="ri-layout-masonry-line"></i> 现代 UI 字体</span>
          <h2>适合制作矢量 Logo 与 WebGL 挤压的字体</h2>
          <p class="subtitle">曲线平滑、节点数少，生成代码体积超轻量。</p>
        </div>

        <div class="font-pills-container">
          {modernFonts.map(mf => (
            <a href={`/zh/fonts/${mf.slug}/`} class="font-pill">
              <span>{mf.name}</span>
              <span class="font-pill-cat">极简节点</span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- 常见问题解答 -->
    <section class="seo-section bg-alt" id="faq">
      <div class="seo-container">
        <div class="section-header">
          <span class="badge"><i class="ri-question-line"></i> 前端性能答疑</span>
          <h2>常见问题解答</h2>
          <p class="subtitle">关于首屏指标优化、Three.js 挤压与自动化 CLI 调用的技巧。</p>
        </div>

        <div class="faq-list">
          {data.faq.map(item => (
            <details class="faq-item" open>
              <summary class="faq-question">{item.qZh}</summary>
              <div class="faq-answer">
                <p>{item.aZh}</p>
              </div>
            </details>
          ))}
        </div>
      </div>
    </section>
  </div>
</Layout>
