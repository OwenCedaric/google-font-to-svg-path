---
import Layout from '../../../layouts/Layout.astro';
import { USE_CASES } from '../../../data/useCasesData';
import { POPULAR_FONTS } from '../../../data/fontsData';
import 'remixicon/fonts/remixicon.css';
import '../../../styles/index.css';

const data = USE_CASES['laser-cutting-text-to-dxf'];
const industrialFonts = POPULAR_FONTS.filter(f => f.category === 'display' || f.category === 'sans-serif' || f.category === 'cjk').slice(0, 12);
const toolUrl = `/zh/?font=${encodeURIComponent(data.initialFont)}&union=true&dxfUnits=mm&text=${encodeURIComponent(data.initialText)}`;
---

<Layout
  isApp={false}
  lang="zh"
  title={data.seoTitleZh}
  description={data.seoDescriptionZh}
>
  <div class="about-page">
    <header class="about-hero">
      <div class="seo-container">
        <span class="badge"><i class="ri-crosshair-2-line"></i> {data.badgeZh}</span>
        <h1 class="hero-title">{data.titleZh}</h1>
        <p class="hero-subtitle">{data.subtitleZh}</p>
        <div class="hero-actions">
          <a href={toolUrl} class="btn btn-primary">
            <i class="ri-magic-line"></i>
            <span>启动激光 DXF 生成工具</span>
          </a>
          <a href="#guide" class="btn btn-outline">
            <i class="ri-book-open-line"></i>
            <span>CAM 下料流程</span>
          </a>
        </div>
      </div>
    </header>

    <!-- 核心优势与参数说明 -->
    <section class="seo-section" id="overview">
      <div class="seo-container">
        <!-- 为什么真实尺寸单位极其关键 -->
        <div style="background: #eff6ff; border: 1px solid #bfdbfe; border-radius: 12px; padding: 1.5rem 1.75rem; margin-bottom: 3.5rem;">
          <h3 style="font-size: 1.125rem; font-weight: 700; color: #1e40af; margin: 0 0 0.5rem; display: flex; align-items: center; gap: 0.5rem;">
            <i class="ri-ruler-2-line"></i> {data.whyTitleZh}
          </h3>
          <p style="font-size: 0.9375rem; color: #1e3a8a; line-height: 1.6; margin: 0;">
            {data.whyContentZh}
          </p>
        </div>

        <div class="features-grid">
          {data.features.map(f => (
            <article class="feature-card">
              <div class="feature-icon"><i class={f.icon}></i></div>
              <h3>{f.titleZh}</h3>
              <p>{f.descZh}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- 步骤指南 -->
    <section class="seo-section bg-alt" id="guide">
      <div class="seo-container">
        <div class="section-header">
          <span class="badge"><i class="ri-book-open-line"></i> CAM 流程</span>
          <h2>如何生成激光与数控机床专用的 DXF 图纸</h2>
          <p class="subtitle">几秒钟内将文字转换为可直接排料下料的 CAD 轮廓。</p>
        </div>

        <div class="steps-grid">
          {data.steps.map((s, idx) => (
            <div class="step-card">
              <div class="step-number">{idx + 1}</div>
              <h3>{s.titleZh}</h3>
              <p>{s.descZh}</p>
            </div>
          ))}
        </div>

        <div style="text-align: center; margin-top: 3rem;">
          <a href={toolUrl} class="btn btn-primary">
            <i class="ri-magic-line"></i>
            <span>立即在主工具中导出 DXF</span>
          </a>
        </div>
      </div>
    </section>

    <!-- 推荐工业与防掉心镂空字体 -->
    <section class="seo-section" id="fonts">
      <div class="seo-container">
        <div class="section-header">
          <span class="badge"><i class="ri-font-size"></i> 加工适用字体</span>
          <h2>推荐用于激光切割与实木数控雕刻的字体</h2>
          <p class="subtitle">笔画厚实稳固，抗断裂性能优越。</p>
        </div>

        <div class="font-pills-container">
          {industrialFonts.map(inf => (
            <a href={`/zh/fonts/${inf.slug}/`} class="font-pill">
              <span>{inf.name}</span>
              <span class="font-pill-cat">DXF 就绪</span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- 常见问题解答 -->
    <section class="seo-section bg-alt" id="faq">
      <div class="seo-container">
        <div class="section-header">
          <span class="badge"><i class="ri-question-line"></i> 激光加工答疑</span>
          <h2>常见问题解答</h2>
          <p class="subtitle">关于 DXF 单位、兼容性与加工防掉心的建议。</p>
        </div>

        <div class="faq-list">
          {data.faq.map(item => (
            <details class="faq-item" open>
              <summary class="faq-question">{item.qZh}</summary>
              <div class="faq-answer">
                <p>{item.aZh}</p>
              </div>
            </details>
          ))}
        </div>
      </div>
    </section>
  </div>
</Layout>
