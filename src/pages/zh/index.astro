---
import Layout from '../../layouts/Layout.astro';
import App from '../../components/App.tsx';
import 'remixicon/fonts/remixicon.css';
import '../../styles/index.css';
---

<Layout isApp={true} lang="zh">
  <script is:inline src="/bezier.js" slot="head"></script>
  
  <App client:idle lang="zh" slot="content" />

  <!-- 搜索引擎爬虫与屏幕阅读器语义化内容 -->
  <section class="sr-only" aria-label="工具概述与字体转矢量说明">
    <h2>Google 字体与本地字体转 SVG 路径 / CAD DXF 矢量生成器</h2>
    <p>
      FontSVG 是一款免费、无广告、纯前端运行的字体矢量化转换工具。支持 1,500+ 款 Google 在线字体，并支持直接上传本地电脑里的 TTF、OTF、WOFF 字体文件（包括中文字体与日文字体），毫秒级提取平滑无损的 SVG 路径（&lt;path d="..."&gt;）与 CAD DXF 轮廓线。
    </p>
    <h3>核心功能特点</h3>
    <ul>
      <li><strong>1,500+ Google 在线字体</strong>：纯前端极速搜索与渲染。</li>
      <li><strong>本地商用字体上传</strong>：100% 浏览器本地离线解析，文件不离网，严格保障版权安全。</li>
      <li><strong>连笔草书布尔焊接 (Union)</strong>：针对花体字与草书消除内部交叉线，生成单一平滑外轮廓，彻底避免激光雕刻和 Cricut 刻字机切烂材料。</li>
      <li><strong>CAD DXF 工业级导出</strong>：支持毫米（mm）、厘米（cm）、英寸（inch）等实际物理单位，无缝对接 LightBurn、LaserCAD 与数控机床。</li>
      <li><strong>前端开发者代码提取</strong>：一键复制纯净 &lt;path d&gt; 字符串，适配 React、Vue、Tailwind 与 Three.js 3D 挤压。</li>
    </ul>
    <h3>字体转矢量使用步骤</h3>
    <ol>
      <li>选择 Google 字体或上传本地 TTF/OTF 文件。</li>
      <li>输入需要转换的文字内容，并配置字号、行高与字距。</li>
      <li>如果是连笔或手写艺术字，勾选“合并重叠路径 (Union)”消除内部交叉线。</li>
      <li>点击“复制 SVG 路径”直接取用代码，或点击“下载 SVG”与“导出 CAD DXF”保存图纸文件。</li>
    </ol>
  </section>
</Layout>
